<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Luna</AssemblyName>
    <RootNamespace>Luna</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Luna</Product>
    <Description>Drag a file, press Shift, drop it on a format.</Description>
    <Authors>arlxaa</Authors>
    <RepositoryUrl>https://github.com/arlxaa/luna</RepositoryUrl>
    <ApplicationIcon>Assets\luna.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Lightweight: no NuGet packages; runs on the installed .NET Desktop Runtime. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 → one small Luna.exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\luna.ico" LogicalName="luna.ico" />
    <InternalsVisibleTo Include="Luna.DevTools" />
  </ItemGroup>

</Project>
